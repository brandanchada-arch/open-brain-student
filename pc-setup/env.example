# Open Brain PC settings — TEMPLATE with placeholders only.
# Copy to %USERPROFILE%\.open-brain\.env and fill in. That folder is outside every repo.
# Never commit the real file. Lines starting with # are ignored.

# Where your Supabase edge functions live (no trailing slash). Replace <your-project-ref>.
OPEN_BRAIN_FUNCTIONS_URL=https://<your-project-ref>.supabase.co/functions/v1

# The same MCP_ACCESS_KEY that is in Supabase → Edge Functions → Secrets.
MCP_ACCESS_KEY=<paste-your-mcp-access-key-here>

# ---- Weekly export (item 4) ----
# Optional. Default: %USERPROFILE%\open-brain-export
# EXPORT_DIR=C:\Users\<you>\open-brain-export

# ---- Session-start hook (item 5) ----
# on = load the core page into each Claude Code session. off = do nothing.
CORE_HOOK=on

# ---- Session log hook (item 6) ----
# on = write a short summary of each session to %USERPROFILE%\claude-session-logs. off = do nothing.
SESSION_LOGS=on
# Upload each summary to Open Brain with add_session_log. Leave OFF until you have read some logs.
SESSION_LOG_UPLOAD=off
# Optional project name sent with uploads.
# SESSION_LOG_PROJECT=open-brain
